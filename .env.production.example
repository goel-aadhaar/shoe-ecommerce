# ==========================================================================
# urban-sole — production environment (Droplet)
#
#   cp .env.production.example .env.production   &&   fill in real values
#   docker compose -f docker-compose.prod.yml --env-file .env.production up -d --build
#
# NEVER commit .env.production. It is gitignored.
# ==========================================================================

# Public origin, scheme included, NO trailing slash.
# Used for CORS and baked into the frontend bundle at build time — changing it
# requires `--build`, not just a restart.
PUBLIC_ORIGIN=https://example.com

# --- MongoDB (Atlas) -------------------------------------------------------
# Add the Droplet's public IP to the Atlas Network Access allowlist, or the
# connection will hang and every request will 500.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/UrbanSole?retryWrites=true&w=majority
MONGO_DB=UrbanSole

# --- Auth ------------------------------------------------------------------
# Generate with: openssl rand -base64 48
ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=
ACCESS_TOKEN_EXPIRY=1d
REFRESH_TOKEN_EXPIRY=10d

# --- Express <-> AI service shared secret -----------------------------------
# Generate with: openssl rand -base64 36
# The AI service refuses to boot in production if this is left as a placeholder.
SERVICE_TOKEN=

# --- LLM gateway -----------------------------------------------------------
LLM_GATEWAY_BASE_URL=https://llm-gateway-azure.penpencil.guru/v1
LLM_GATEWAY_API_KEY=
LLM_CHAT_MODEL=MiniMax-M2.5
LLM_HIGHSPEED_MODEL=MiniMax-M2.5-highspeed

# --- Stripe ----------------------------------------------------------------
# Webhook endpoint: https://example.com/api/v1/payments/webhook
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Cloudinary ------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
