# Everything here is either rebuilt inside the image or must never reach it.
# Without this file Docker uploads node_modules and .next as build context --
# ~350 MB, which took over four minutes before the build even started.

node_modules
.next
out
build
dist

# Secrets: NEXT_PUBLIC_API_URL is passed as a build arg, never copied in.
.env
.env.*
!.env.example

npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

.git
.gitignore
README.md
Dockerfile
.dockerignore

.vscode
.idea
.DS_Store
Thumbs.db

coverage
.turbo
*.tsbuildinfo
